<%- include('./partials/head') %>
<body class="bg-gray-50 min-h-screen">

  <%- include('./partials/navbar') %>

  <main class="py-10 px-4">
    <div class="max-w-2xl mx-auto">

      <!-- Back Button -->
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-800 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
          viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Listings
      </a>

      <!-- Card -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">

        <!-- Image Slider -->
        <% if (ad.image && ad.image.length > 0) { %>
          <div class="relative w-full h-64 bg-gray-100" id="slider">

            <!-- Images -->
            <% ad.image.forEach((image, index) => { %>
              <img
                src="/uploads/<%= image %>"
                alt="<%= ad.itemName %>"
                class="absolute inset-0 w-full h-64 object-cover transition-opacity duration-300 <%= index === 0 ? 'opacity-100' : 'opacity-0' %>"
                data-index="<%= index %>"
                id="slide-<%= index %>"
              />
            <% }) %>

            <!-- Prev Button -->
            <% if (ad.image.length > 1) { %>
              <button onclick="changeSlide(-1)"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 bg-white/80 hover:bg-white
                       rounded-full flex items-center justify-center shadow transition z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-700" fill="none"
                  viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <!-- Next Button -->
              <button onclick="changeSlide(1)"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 bg-white/80 hover:bg-white
                       rounded-full flex items-center justify-center shadow transition z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-700" fill="none"
                  viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <!-- Dots -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10">
                <% ad.image.forEach((_, index) => { %>
                  <button onclick="goToSlide(<%= index %>)"
                    class="w-2 h-2 rounded-full transition-all duration-200 <%= index === 0 ? 'bg-white w-4' : 'bg-white/50' %>"
                    id="dot-<%= index %>">
                  </button>
                <% }) %>
              </div>

              <!-- Counter -->
              <div class="absolute top-3 right-3 bg-black/40 text-white text-xs px-2 py-1 rounded-full z-10">
                <span id="counter">1</span> / <%= ad.image.length %>
              </div>
            <% } %>

          </div>

        <% } else { %>
          <!-- No Image Placeholder -->
          <div class="w-full h-64 bg-gray-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-300" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% } %>

        <!-- Top Banner -->
        <div class="bg-blue-600 px-6 py-5 flex items-center justify-between">
          <span class="text-xs font-semibold text-blue-100 bg-blue-500 px-3 py-1 rounded-full uppercase tracking-wide">
            <%= ad.adType %>
          </span>
          <span class="text-xs text-blue-200">
            <%= new Date(ad.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </span>
        </div>

        <!-- Body -->
        <div class="p-6 space-y-6">

          <!-- Title & Price -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <h1 class="text-xl font-semibold text-gray-900"><%= ad.itemName %></h1>
              <p class="text-sm text-gray-400 mt-0.5">
                Listed by <span class="text-gray-600 font-medium"><%= ad.postedBy %></span>
              </p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-2xl font-bold text-blue-600">₹<%= Number(ad.price).toLocaleString('en-IN') %></p>
              <p class="text-xs text-gray-400">Negotiable</p>
            </div>
          </div>

          <div class="border-t border-gray-100"></div>

          <!-- Details Grid -->
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-xl px-4 py-3">
              <p class="text-xs text-gray-400 mb-0.5">Category</p>
              <p class="text-sm font-medium text-gray-700 capitalize"><%= ad.adType %></p>
            </div>
            <div class="bg-gray-50 rounded-xl px-4 py-3">
              <p class="text-xs text-gray-400 mb-0.5">Location</p>
              <p class="text-sm font-medium text-gray-700"><%= ad.location %></p>
            </div>
            <div class="bg-gray-50 rounded-xl px-4 py-3">
              <p class="text-xs text-gray-400 mb-0.5">Posted On</p>
              <p class="text-sm font-medium text-gray-700">
                <%= new Date(ad.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </p>
            </div>
            <div class="bg-gray-50 rounded-xl px-4 py-3">
              <p class="text-xs text-gray-400 mb-0.5">Seller Name</p>
              <p class="text-sm font-medium text-gray-700 truncate"><%= ad.sellername %></p>
            </div>
          </div>

          <div class="border-t border-gray-100"></div>

          <!-- Contact Buttons -->
          <div>
            <p class="text-sm font-medium text-gray-700 mb-3">Contact Seller</p>
            <div class="flex gap-3">
              <a href="tel:+91<%= ad.contact %>"
                class="flex-1 flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700
                       text-white text-sm font-medium py-2.5 rounded-xl transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
                  viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z" />
                </svg>
                Call Seller
              </a>
              <a href="https://wa.me/91<%= ad.contact %>" target="_blank"
                class="flex-1 flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600
                       text-white text-sm font-medium py-2.5 rounded-xl transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.528 5.855L.057 23.882a.5.5 0 00.61.611l6.101-1.458A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.808 9.808 0 01-5.031-1.388l-.36-.214-3.733.892.924-3.638-.235-.374A9.818 9.818 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
                </svg>
                WhatsApp
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>

  <!-- Slider Script -->
  <script>
    let current = 0;
    const total = <%= ad.image ? ad.image.length : 0 %>;

    function goToSlide(index) {
      document.getElementById('slide-' + current).classList.replace('opacity-100', 'opacity-0');
      document.getElementById('dot-' + current).classList.remove('bg-white', 'w-4');
      document.getElementById('dot-' + current).classList.add('bg-white/50');

      current = index;

      document.getElementById('slide-' + current).classList.replace('opacity-0', 'opacity-100');
      document.getElementById('dot-' + current).classList.remove('bg-white/50');
      document.getElementById('dot-' + current).classList.add('bg-white', 'w-4');
      document.getElementById('counter').textContent = current + 1;
    }

    function changeSlide(direction) {
      let next = (current + direction + total) % total;
      goToSlide(next);
    }
  </script>
  <%- include('./partials/footer') %>
</body>
</html>