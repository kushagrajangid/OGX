<nav class="flex items-center justify-between px-6 py-3 rounded-xl" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">

  <a href="/">
  <svg width="110" height="38" viewBox="0 0 520 200">
    <circle cx="75" cy="100" r="72" fill="#3b6ef5"/>
    <circle cx="75" cy="100" r="33" fill="white"/>
    <text x="228" y="150" font-family="Arial Black, Arial" font-weight="900" font-size="148" fill="#3b6ef5" text-anchor="middle">G</text>
    <rect x="332" y="26" width="148" height="148" rx="22" fill="#3b6ef5"/>
    <line x1="355" y1="49" x2="457" y2="151" stroke="white" stroke-width="32" stroke-linecap="round"/>
    <line x1="457" y1="49" x2="355" y2="151" stroke="white" stroke-width="32" stroke-linecap="round"/>
  </svg>
</a>
<form action="/themechanger" method="POST">
  <button type="submit"
    class="relative inline-flex items-center cursor-pointer rounded-full p-1 transition-all duration-300 border-none"
    style="width: 52px; height: 28px; background: <%= theme === 'dark' ? '#3b82f6' : 'rgba(0,0,0,0.2)' %>;">
    <span
      class="block rounded-full bg-white shadow transition-transform duration-300"
      style="width: 22px; height: 22px; transform: translateX(<%= theme === 'dark' ? '24px' : '0px' %>);">
    </span>
  </button>
</form>
  <div class="flex items-center gap-2 ml-auto">
    <% if(isLoggedIn){ %>
    <a href="/myadds" class="px-4 py-2 text-sm text-gray-600 rounded-lg hover:bg-white/10 transition">My Ads</a>
    <a href="/postadd" class="px-4 py-2 text-sm text-gray-600 rounded-lg hover:bg-white/10 transition">Post an Ad</a>
    <a href="/favouriteslist" class="px-4 py-2 text-sm text-gray-600 rounded-lg hover:bg-white/10 transition">❤️ Favourites</a>
    <% } %>
    <% if(!isLoggedIn){ %>
    <a href="/login" class="px-4 py-2 text-sm font-medium text-white rounded-lg hover:bg-white/10 transition" style="border: 1px solid rgba(255,255,255,0.2);">Login</a>
    <% }else{ %>
    <a href="/logout" class="px-4 py-2 text-sm font-medium text-white rounded-lg hover:bg-white/10 transition" style="border: 1px solid rgba(255,255,255,0.2);">Logout</a>
    <% } %>

    <!-- Hamburger inside the div -->
    <button id="menuBtn" class="lg:hidden p-2 rounded-lg hover:bg-white/10 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

</nav>

<!-- Mobile Dropdown -->
<div id="mobileMenu" class="hidden flex-col rounded-xl mt-1 px-4 py-3 gap-1 lg:hidden" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
  <% if(isLoggedIn){ %>
  <a href="/myadds" class="block px-4 py-2 text-sm text-gray-300 rounded-lg hover:bg-white/10 transition">My Ads</a>
  <a href="/postadd" class="block px-4 py-2 text-sm text-gray-300 rounded-lg hover:bg-white/10 transition">Post an Ad</a>
  <a href="/favouriteslist" class="block px-4 py-2 text-sm text-gray-300 rounded-lg hover:bg-white/10 transition">❤️ Favourites</a>
  <% } %>
  <% if(!isLoggedIn){ %>
  <a href="/login" class="block px-4 py-2 text-sm font-medium text-white rounded-lg hover:bg-white/10 transition" style="border: 1px solid rgba(255,255,255,0.2);">Login</a>
  <% }else{ %>
  <a href="/logout" class="block px-4 py-2 text-sm font-medium text-white rounded-lg hover:bg-white/10 transition" style="border: 1px solid rgba(255,255,255,0.2);">Logout</a>
  <% } %>
</div>

<script>
  const menuBtn = document.getElementById('menuBtn');
  const mobileMenu = document.getElementById('mobileMenu');

  menuBtn.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
    mobileMenu.classList.toggle('flex');
  });

  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
    });
  });
</script>