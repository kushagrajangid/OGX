<%- include('./partials/head') %>
<body class="min-h-screen flex flex-col" style="margin:0; padding:0;">

<%- include('./partials/waves') %>
  <%- include('./partials/navbar') %>
  <div class="flex-1">
  <main class="py-10 px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-semibold text-white">My Ads</h1>
          <p class="text-sm text-gray-400 mt-0.5"><%= ads.length %> ads posted</p>
        </div>
        <a href="/postadd"
          class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-xl transition">
          + Post an Ad
        </a>
      </div>

      <!-- Empty State -->
      <% if (ads.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background: rgba(255,255,255,0.08);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <p class="text-white font-medium">No ads posted yet</p>
          <p class="text-gray-400 text-sm mt-1">Start by posting your first listing!</p>
          <a href="/postadd"
            class="mt-4 px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition">
            + Post an Ad
          </a>
        </div>

      <% } else { %>

        <!-- Ad List -->
        <div class="space-y-4">
          <% ads.forEach(ad => { %>
            <div class="rounded-2xl p-5 flex items-center justify-between gap-4" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">

              <!-- Left: Icon + Info -->
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(59,110,245,0.2);">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-400" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2v-4M9 21H5a2 2 0 01-2-2v-4m0 0h18" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-white truncate"><%= ad.itemName %></h3>
                  <div class="flex items-center gap-3 mt-0.5 flex-wrap">
                    <span class="text-xs text-blue-300 px-2 py-0.5 rounded-full capitalize" style="background: rgba(255,255,255,0.1);">
                      <%= ad.adType %>
                    </span>
                    <span class="text-xs text-gray-400"><%= ad.location %></span>
                    <span class="text-xs text-gray-400">
                      <%= new Date(ad.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Right: Price + Actions -->
              <div class="flex items-center gap-3 shrink-0">
  <p class="text-sm font-bold text-white">₹<%= Number(ad.price).toLocaleString('en-IN') %></p>

  <a href="/detail/<%= ad.slug %>"
    class="text-xs text-gray-300 px-3 py-1.5 rounded-lg hover:bg-white/10 transition"
    style="border: 1px solid rgba(255,255,255,0.15); line-height: 1;">
    View
  </a>

  <form action="/addelete/<%= ad._id %>" method="POST" style="margin:0; padding:0; display:flex;">
    <button type="submit"
      class="text-xs text-red-400 px-3 py-1.5 rounded-lg hover:bg-red-500/10 transition"
      style="border: 1px solid rgba(239,68,68,0.3); line-height: 1;">
      Delete
    </button>
  </form>
</div>

            </div>
          <% }) %>
        </div>

      <% } %>

    </div>
  </main>
  </div>
  <%- include('./partials/footer') %>
</body>
</html>