<%- include('./partials/head') %>
<body class="min-h-screen bg-gray-50 py-12 px-4">

  <%- include('./partials/navbar') %>

  <div class="w-full max-w-lg mx-auto mt-10">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-semibold text-gray-900">Post an Ad</h1>
      <p class="text-sm text-gray-500 mt-1">Fill in the details below to publish your listing</p>
    </div>

    <!-- Card -->
    <div class="bg-white border border-gray-200 rounded-2xl p-8">
      <form action="/post-ad" method="POST" enctype="multipart/form-data" class="space-y-5">

        <!-- Type of Ad -->
        <div>
          <label for="adType" class="block text-sm font-medium text-gray-700 mb-1.5">
            Type of Ad
          </label>
          <select
            id="adType"
            name="adType"
            required
            class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg
                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                   text-gray-700 bg-white transition">
            <option value="" disabled selected>Select a category</option>
            <option value="electronics">Electronics</option>
            <option value="furniture">Furniture</option>
            <option value="vehicles">Vehicles</option>
            <option value="realestate">Real Estate</option>
            <option value="fashion">Fashion</option>
            <option value="jobs">Jobs</option>
            <option value="services">Services</option>
            <option value="other">Other</option>
          </select>
        </div>

        <!-- Item Name -->
        <div>
          <label for="itemName" class="block text-sm font-medium text-gray-700 mb-1.5">
            Name of Item
          </label>
          <input
            type="text"
            id="itemName"
            name="itemName"
            placeholder="e.g. iPhone 14 Pro, Wooden Sofa..."
            required
            class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg
                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                   placeholder-gray-400 transition"
          />
        </div>

        <!-- Price -->
        <div>
          <label for="price" class="block text-sm font-medium text-gray-700 mb-1.5">
            Price (₹)
          </label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm font-medium">₹</span>
            <input
              type="number"
              id="price"
              name="price"
              placeholder="0.00"
              min="0"
              required
              class="w-full pl-8 pr-4 py-2.5 text-sm border border-gray-300 rounded-lg
                     focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                     placeholder-gray-400 transition"
            />
          </div>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-sm font-medium text-gray-700 mb-1.5">
            Location
          </label>
          <input
            type="text"
            id="location"
            name="location"
            placeholder="e.g. Jaipur, Rajasthan"
            required
            class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg
                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                   placeholder-gray-400 transition"
          />
        </div>

        <!-- Contact Number -->
        <div>
          <label for="contact" class="block text-sm font-medium text-gray-700 mb-1.5">
            Contact Number
          </label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm">+91</span>
            <input
              type="tel"
              id="contact"
              name="contact"
              placeholder="98765 43210"
              maxlength="10"
              pattern="[0-9]{10}"
              required
              class="w-full pl-12 pr-4 py-2.5 text-sm border border-gray-300 rounded-lg
                     focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                     placeholder-gray-400 transition"
            />
          </div>
        </div>

        <!-- File Picker -->
        <div>
          <label for="photo" class="block text-sm font-medium text-gray-700 mb-1.5">
            Upload Photos
          </label>
          <label for="photo"
            class="flex flex-col items-center justify-center w-full border-2 border-dashed
                   border-gray-300 rounded-lg py-6 px-4 cursor-pointer
                   hover:border-blue-400 hover:bg-blue-50 transition-colors duration-150">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400 mb-2" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm text-gray-500">
              <span class="text-blue-600 font-medium">Click to upload</span> or drag and drop
            </p>
            <p class="text-xs text-gray-400 mt-1">PNG, JPG, JPEG up to 5MB (max 5 images)</p>

            <!-- ✅ name="image" matches multer .array('image', 5) in app.js -->
            <input
              type="file"
              id="photo"
              name="image"
              accept="image/*"
              multiple
              class="hidden"
              onchange="previewImages(event)"
            />
          </label>

          <!-- Preview -->
          <div id="preview" class="flex flex-wrap gap-2 mt-3"></div>
        </div>

        <!-- Error message -->
        <% if (typeof error !== 'undefined' && error) { %>
          <p class="text-sm text-red-500 bg-red-50 border border-red-200 rounded-lg px-4 py-2.5">
            <%= error %>
          </p>
        <% } %>

        <!-- Submit -->
        <button type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white
                 text-sm font-medium py-2.5 rounded-lg transition-all duration-150">
          + Post Ad
        </button>

      </form>
    </div>

  </div>

  <script>
    // ✅ previews ALL selected images
    function previewImages(event) {
      const preview = document.getElementById('preview');
      preview.innerHTML = '';
      const files = Array.from(event.target.files).slice(0, 5); // max 5
      files.forEach(file => {
        const reader = new FileReader();
        reader.onload = (e) => {
          preview.innerHTML += `
            <img src="${e.target.result}"
              class="w-24 h-24 object-cover rounded-lg border border-gray-200" />
          `;
        };
        reader.readAsDataURL(file);
      });
    }
  </script>

</body>
</html>