<%- include('./partials/head') %>
<body class="min-h-screen flex flex-col" style="margin:0; padding:0;">

<%- include('./partials/waves') %>
  <%- include('./partials/navbar') %>

  <div class="w-full max-w-lg mx-auto mt-10 px-4 pb-16">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-semibold text-white">Post an Ad</h1>
      <p class="text-sm text-gray-400 mt-1">Fill in the details below to publish your listing</p>
    </div>

    <!-- Card -->
    <div class="rounded-2xl p-8" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
      <form action="/post-ad" method="POST" enctype="multipart/form-data" class="space-y-5">

        <!-- Type of Ad -->
        <div>
          <label for="adType" class="block text-sm font-medium text-gray-300 mb-1.5">Type of Ad</label>
          <select id="adType" name="adType" required
            class="w-full px-4 py-2.5 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #e5e7eb;">
            <option value="" disabled selected style="background:#1f2937;">Select a category</option>
            <option value="electronics" style="background:#1f2937;">Electronics</option>
            <option value="furniture" style="background:#1f2937;">Furniture</option>
            <option value="vehicles" style="background:#1f2937;">Vehicles</option>
            <option value="realestate" style="background:#1f2937;">Real Estate</option>
            <option value="fashion" style="background:#1f2937;">Fashion</option>
            <option value="jobs" style="background:#1f2937;">Jobs</option>
            <option value="services" style="background:#1f2937;">Services</option>
            <option value="other" style="background:#1f2937;">Other</option>
          </select>
        </div>

        <!-- Item Name -->
        <div>
          <label for="itemName" class="block text-sm font-medium text-gray-300 mb-1.5">Name of Item</label>
          <input type="text" id="itemName" name="itemName"
            placeholder="e.g. iPhone 14 Pro, Wooden Sofa..." required
            class="w-full px-4 py-2.5 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #e5e7eb;"
          />
        </div>

        <!-- Price -->
        <div>
          <label for="price" class="block text-sm font-medium text-gray-300 mb-1.5">Price (₹)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm font-medium">₹</span>
            <input type="number" id="price" name="price"
              placeholder="0.00" min="0" required
              class="w-full pl-8 pr-4 py-2.5 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
              style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #e5e7eb;"
            />
          </div>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-sm font-medium text-gray-300 mb-1.5">Location</label>
          <input type="text" id="location" name="location"
            placeholder="e.g. Jaipur, Rajasthan" required
            class="w-full px-4 py-2.5 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #e5e7eb;"
          />
        </div>

        <!-- Contact Number -->
        <div>
          <label for="contact" class="block text-sm font-medium text-gray-300 mb-1.5">Contact Number</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm">+91</span>
            <input type="tel" id="contact" name="contact"
              placeholder="98765 43210" maxlength="10" pattern="[0-9]{10}" required
              class="w-full pl-12 pr-4 py-2.5 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
              style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #e5e7eb;"
            />
          </div>
        </div>

        <!-- File Picker -->
        <div>
          <label for="photo" class="block text-sm font-medium text-gray-300 mb-1.5">Upload Photos</label>
          <label for="photo"
            class="flex flex-col items-center justify-center w-full rounded-lg py-6 px-4 cursor-pointer transition-colors duration-150"
            style="border: 2px dashed rgba(255,255,255,0.2); background: rgba(255,255,255,0.03);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400 mb-2" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm text-gray-400">
              <span class="text-blue-400 font-medium">Click to upload</span> or drag and drop
            </p>
            <p class="text-xs text-gray-500 mt-1">PNG, JPG, JPEG up to 5MB (max 5 images)</p>
            <input type="file" id="photo" name="image" accept="image/*" multiple class="hidden" onchange="previewImages(event)" />
          </label>
          <div id="preview" class="flex flex-wrap gap-2 mt-3"></div>
        </div>

        <!-- Error message -->
        <% if (typeof error !== 'undefined' && error) { %>
          <p class="text-sm text-red-400 rounded-lg px-4 py-2.5" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);">
            <%= error %>
          </p>
        <% } %>

        <!-- Submit -->
        <button type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white text-sm font-medium py-2.5 rounded-lg transition-all duration-150">
          + Post Ad
        </button>

      </form>
    </div>

  </div>

  <script>
    function previewImages(event) {
      const preview = document.getElementById('preview');
      preview.innerHTML = '';
      const files = Array.from(event.target.files).slice(0, 5);
      files.forEach(file => {
        const reader = new FileReader();
        reader.onload = (e) => {
          preview.innerHTML += `<img src="${e.target.result}" class="w-24 h-24 object-cover rounded-lg" style="border: 1px solid rgba(255,255,255,0.15);" />`;
        };
        reader.readAsDataURL(file);
      });
    }
  </script>

  <%- include('./partials/footer') %>
</body>
</html>